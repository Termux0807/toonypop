<img src="logo.png" alt="ToonyPop Logo">
<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToonyPop</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      background-color: #fafafa;
      color: #333;
    }
    header {
      background: #ff5e57;
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    header img {
      max-width: 180px;
      margin-bottom: 20px;
    }
    header h1 {
      margin: 0;
      font-size: 3em;
    }
    header p {
      font-size: 1.2em;
      margin-top: 10px;
    }
    main {
      max-width: 900px;
      margin: 40px auto;
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }
    main h2 {
      margin-top: 0;
    }
    form {
      display: flex;
      flex-direction: column;
    }
    input, textarea, select, button {
      font-size: 16px;
      margin-bottom: 20px;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
    }
    button {
      background-color: #ff5e57;
      color: white;
      border: none;
      font-weight: bold;
      transition: background 0.3s ease;
    }
    button:hover {
      background-color: #e14a42;
    }
    .features {
      margin-top: 40px;
      background: #fff7f7;
      padding: 20px;
      border-radius: 12px;
    }
    .features h3 {
      margin-top: 0;
    }
    footer {
      text-align: center;
      background: #333;
      color: white;
      padding: 20px;
      margin-top: 60px;
    }
  </style>
</head>
<body>
  <header>
    <img src="/mnt/data/file-9fsP9yPnXeq66f2Wa6VYgn" alt="ToonyPop Logo">
    <h1>ToonyPop</h1>
    <p>Stream & Monetize Your Original Cartoons and Movie Clips</p>
  </header>  <main>
    <h2>Upload Your Content</h2>
    <form action="#" method="POST" enctype="multipart/form-data">
      <label for="title">Episode Title</label>
      <input type="text" id="title" name="title" placeholder="Enter episode or clip title" required><label for="description">Description</label>
  <textarea id="description" name="description" rows="4" placeholder="Describe your cartoon or movie part..." required></textarea>

  <label for="file">Upload Video File</label>
  <input type="file" id="file" name="file" accept="video/*" required>

  <label for="price">Set Price (USD)</label>
  <input type="number" id="price" name="price" placeholder="e.g. 3.99" step="0.01" required>

  <label for="mint">Mint as NFT?</label>
  <select id="mint" name="mint">
    <option value="no">No</option>
    <option value="yes">Yes</option>
  </select>

  <label for="payment">Preferred Payment Method</label>
  <select id="payment" name="payment" required>
    <option value="paypal">PayPal</option>
    <option value="skrill">Skrill</option>
    <option value="crypto">Crypto Wallet</option>
    <option value="bank">Bank Transfer</option>
  </select>

  <button type="submit">Upload & Monetize</button>
</form>

<div class="features">
  <h3>Monetization Options</h3>
  <ul>
    <li>💵 Pay-per-view or download model</li>
    <li>📺 Subscription-based full access to your cartoon series</li>
    <li>🌐 NFT minting for collectible digital episodes</li>
    <li>🔐 Accept payments via PayPal, Skrill, Crypto Wallet, or Bank Transfer</li>
    <li>🎁 Offer exclusive content and behind-the-scenes access</li>
  </ul>
</div>

  </main>  <footer>
    &copy; 2025 ToonyPop | Built for Creators & Fans Worldwide
  </footer>
</body>
</html>
